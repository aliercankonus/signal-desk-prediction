{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticPrivatePaperJournalEvidence",
  "type": "object", "additionalProperties": false,
  "required": ["evidence_id", "intent_id", "source_kind", "source_identity", "source_sequence", "kind"],
  "properties": {
    "evidence_id": {"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},
    "intent_id": {"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},
    "source_identity": {"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},
    "source_sequence": {"type":"integer","minimum":1,"maximum":32},
    "source_kind": {"const":"synthetic_private_paper_journal"},
    "kind": {"enum":["EXECUTION","FINAL_COMPLETE"]},
    "source_execution_id": {"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},
    "execution_ts": {"type":"string","format":"date-time","maxLength":27},
    "delta_qty_btc": {"type":"string","maxLength":32},
    "price_usdt_per_btc": {"type":"string","maxLength":32},
    "fee_usdt": {"type":"string","maxLength":32},
    "observed_fill_ids": {"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"}},
    "coverage_until": {"type":"string","format":"date-time","maxLength":27},
    "execution_evidence_ids": {"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"}}
  },
  "oneOf": [
    {"properties":{"kind":{"const":"EXECUTION"}},"required":["source_execution_id","execution_ts","delta_qty_btc","price_usdt_per_btc","fee_usdt","observed_fill_ids"],"not":{"anyOf":[{"required":["coverage_until"]},{"required":["execution_evidence_ids"]}]}},
    {"properties":{"kind":{"const":"FINAL_COMPLETE"}},"required":["coverage_until","execution_evidence_ids"],"not":{"anyOf":[{"required":["source_execution_id"]},{"required":["execution_ts"]},{"required":["delta_qty_btc"]},{"required":["price_usdt_per_btc"]},{"required":["fee_usdt"]},{"required":["observed_fill_ids"]}]}}
  ]
}
