{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LedgerEntry",
  "type": "object",
  "required": [
    "ledger_id",
    "ts",
    "entry_type",
    "symbol",
    "config_version",
    "amounts",
    "hash"
  ],
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "entry_type": {
      "enum": [
        "intent_created",
        "risk_reserved",
        "outbox_claimed",
        "local_accepted",
        "outbox_acked",
        "paper_fill",
        "cancel_requested",
        "cancelled",
        "position_opened",
        "position_closed",
        "mark_to_market",
        "reconcile",
        "evidence_registered",
        "incident_resolved",
        "eod_adjustment"
      ]
    },
    "symbol": {
      "const": "BTCUSDT"
    },
    "intent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fill_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_version": {
      "type": "string"
    },
    "amounts": {
      "type": "object"
    },
    "dispatch": {
      "type": "object",
      "description": "Paper-only claim, local acceptance or ACK; never a fill"
    },
    "execution": {
      "type": "object",
      "required": ["event", "state_after"],
      "additionalProperties": false,
      "properties": {
        "event": {"type": "object"},
        "state_after": {"type": "object"},
        "reason": {"enum": ["accounting_limit", "overfill", "cumulative_mismatch",
                            "pre_acceptance", "fill_limit", "unresolved_incident"]}
      },
      "description": "Explicit local-paper fill, cancel or reconciliation transition"
    },
    "evidence": {"type":"object"},
    "evidence_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evidence_byte_length": {"type":"integer","minimum":1,"maximum":4096},
    "resolution": {
      "type":"object", "additionalProperties":false,
      "required":["request","result","state_after"],
      "properties":{
        "request":{"type":"object"},
        "result":{"type":"object"},
        "state_after":{"type":"object"}
      }
    },
    "position_state_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash": {
      "type": "string"
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {"if":{"properties":{"entry_type":{"const":"evidence_registered"}},"required":["entry_type"]},"then":{"required":["evidence","evidence_sha256","evidence_byte_length"]}},
    {"if":{"properties":{"entry_type":{"const":"incident_resolved"}},"required":["entry_type"]},"then":{"required":["resolution"]}},
    {
      "if": {
        "properties": {
          "entry_type": {
            "enum": ["outbox_claimed", "local_accepted", "outbox_acked"]
          }
        },
        "required": ["entry_type"]
      },
      "then": {"required": ["dispatch"]}
    },
    {
      "if": {
        "properties": {
          "entry_type": {"enum": ["paper_fill", "cancel_requested", "cancelled", "reconcile"]}
        },
        "required": ["entry_type"]
      },
      "then": {"required": ["execution"]}
    }
  ]
}